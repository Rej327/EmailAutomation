# ==============================================================================
# EmailAutomation Environment Variables
# Fill these in with your real credentials when ready (see SETUP_GUIDE.md)
# ==============================================================================

# Supabase Credentials
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# Resend API Key
# Found in Resend dashboard -> API Keys
# Default sender in the app is jeffdev2701@gmail.com (or your verified domain sender e.g. onboard@resend.dev)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Default Sender Email
NEXT_PUBLIC_DEFAULT_SENDER_EMAIL=jeffdev2701@gmail.com
